<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="whatsapp_message_view_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'failed'" decoration-muted="status == 'draft'">
                <field name="create_date" string="Date"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="direction" widget="badge"
                       decoration-info="direction == 'outgoing'"
                       decoration-success="direction == 'incoming'"/>
                <field name="message_type"/>
                <field name="body" string="Message" widget="char"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('delivered', 'read')"
                       decoration-info="status == 'sent'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="whatsapp_message_view_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_send" type="object" string="Retry"
                            class="btn-warning" invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,sent,delivered,read"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="message_type"/>
                            <field name="template_id" invisible="message_type != 'template'"/>
                            <field name="wa_message_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message">
                            <field name="body"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                        <page string="Related Record" invisible="not res_model">
                            <group>
                                <field name="res_model" readonly="1"/>
                                <field name="res_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="whatsapp_message_view_search" model="ir.ui.view">
        <field name="name">whatsapp.message.search</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="body"/>
                <filter string="Outgoing" name="outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <filter string="Incoming" name="incoming" domain="[('direction', '=', 'incoming')]"/>
                <separator/>
                <filter string="Sent" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Delivered" name="delivered" domain="[('status', '=', 'delivered')]"/>
                <filter string="Read" name="read" domain="[('status', '=', 'read')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="whatsapp_message_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No messages yet
            </p>
            <p>
                Send your first WhatsApp message from a Contact, Sales Order, or Invoice.
            </p>
        </field>
    </record>

</odoo>
