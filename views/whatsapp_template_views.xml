<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="whatsapp_template_view_list" model="ir.ui.view">
        <field name="name">whatsapp.template.list</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_name"/>
                <field name="category" widget="badge"
                       decoration-info="category == 'utility'"
                       decoration-warning="category == 'marketing'"
                       decoration-danger="category == 'authentication'"/>
                <field name="language"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-info="status == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="whatsapp_template_view_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit_to_meta" type="object"
                            string="Submit to Meta" class="btn-primary"
                            icon="fa-cloud-upload"
                            invisible="status != 'draft'"
                            confirm="This will create the template in Meta Business Manager. Continue?"/>
                    <button name="action_sync_status" type="object"
                            string="Check Status" class="btn-secondary"
                            icon="fa-refresh"
                            invisible="status != 'draft'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_name"/>
                            <field name="category"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="model_id"/>
                            <field name="header_type"/>
                            <field name="header_text" invisible="header_type != 'text'"/>
                            <field name="footer_text"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body" placeholder="Template body preview. Use {{1}}, {{2}} for variables..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp template
            </p>
            <p>
                Templates must be registered and approved in Meta Business Manager before they can be sent.
                Use "Sync Templates" to import them, or create one here and submit to Meta.
            </p>
        </field>
    </record>

    <!-- Server Action: Sync Templates from Meta -->
    <record id="action_sync_templates_from_meta" model="ir.actions.server">
        <field name="name">Sync Templates from Meta</field>
        <field name="model_id" ref="model_whatsapp_template"/>
        <field name="binding_model_id" ref="model_whatsapp_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">model.action_sync_templates()</field>
    </record>

</odoo>
